# PC Builder 2 - example environment file.
# Copy this to .env and fill in real values. Never commit .env (it is
# gitignored). Every value here is empty or an angle-bracket placeholder -
# no real secret has ever been placed in this file.

# ---------------------------------------------------------------------
# HTTP Configuration
# ---------------------------------------------------------------------

# Per-request timeout in seconds for outbound HTTP calls. Blank = default 20.
REQUEST_TIMEOUT=

# ---------------------------------------------------------------------
# Retry Configuration
# ---------------------------------------------------------------------

# Max retry attempts for outbound HTTP calls. Blank = default 3.
MAX_RETRIES=
# Exponential backoff factor between retries. Blank = default 2.
BACKOFF_FACTOR=

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------

# Python logging level (e.g. DEBUG, INFO, WARNING). Blank = default INFO.
LOG_LEVEL=

# ---------------------------------------------------------------------
# AI / LLM Configuration
# ---------------------------------------------------------------------

# Groq API key, used by the extraction pipeline's provider chain.
GROQ_API_KEY=<your-groq-api-key>
# Cerebras API key, used by the extraction pipeline's provider chain.
CEREBRAS_API_KEY=<your-cerebras-api-key>
# Mistral API key, used by the extraction pipeline's provider chain.
MISTRAL_API_KEY=<your-mistral-api-key>
# Google (Gemini) API key, used by the extraction pipeline's provider chain.
GOOGLE_API_KEY=<your-google-api-key>
# NVIDIA API key, used by the extraction pipeline's provider chain.
NVIDIA_API_KEY=<your-nvidia-api-key>

# ---------------------------------------------------------------------
# Matching Pipeline Configuration
# ---------------------------------------------------------------------

# Minimum fuzzy-match score (0-1) to accept a product match. Blank = default 0.90.
FUZZY_MATCH_THRESHOLD=

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------

# Full SQLAlchemy connection string. Required - the app refuses to start
# without it (SEC-02).
DATABASE_URL=<postgresql+psycopg://user:password@host:5432/pc_builder>

# ---------------------------------------------------------------------
# Runtime environment / web security
# ---------------------------------------------------------------------

# "development" or "production". Blank = default development. Production
# hides /docs, /redoc and /openapi.json.
ENV=
# Comma-separated list of origins allowed to make cross-origin requests
# (e.g. https://pcbuilder.example,https://www.pcbuilder.example). Blank
# means no cross-origin access at all (this is also the default).
CORS_ALLOWED_ORIGINS=

# Set true only once the origin accepts traffic from Cloudflare IPs only
# (Phase 3, OPS-02). Blank = default false. Until OPS-02 this must stay false.
# Only "true" or "false" (case/whitespace-insensitive) are accepted - any
# other value refuses to start.
TRUST_CF_CONNECTING_IP=

# Rate limits (plan 01-05). The API must run as a single process - limiter
# counters are in memory, so each extra worker multiplies the effective
# limit. Only "true" or "false" are accepted for RATE_LIMIT_ENABLED (blank =
# default true); the RATE_LIMIT_* strings below are validated at startup
# (limits.parse_many) - a typo refuses to start rather than 500ing requests.
RATE_LIMIT_ENABLED=
# Blank = default 300/minute.
RATE_LIMIT_DEFAULT=
# Blank = default 120/minute.
RATE_LIMIT_IMAGES=
# Blank = default 60/minute.
RATE_LIMIT_BUILDER=
# Blank = default 10/minute.
RATE_LIMIT_SAVE_BUILD=

# Support/contact address shown on the About page. Leave empty until the
# owner picks the address; the About page then shows a "contact address
# coming soon" note.
CONTACT_EMAIL=

# ---------------------------------------------------------------------
# Docker Compose (local Postgres / pgAdmin / Airflow)
# ---------------------------------------------------------------------

# Local Postgres password used by docker-compose.yml.
POSTGRES_PASSWORD=<your-postgres-password>
# pgAdmin login email, used by docker-compose.yml.
PGADMIN_DEFAULT_EMAIL=<you@example.com>
# pgAdmin login password, used by docker-compose.yml.
PGADMIN_DEFAULT_PASSWORD=<your-pgadmin-password>
# Airflow Fernet key (encrypts Airflow connection secrets at rest).
AIRFLOW_FERNET_KEY=<your-airflow-fernet-key>
# Airflow webserver session secret key.
AIRFLOW_WEBSERVER_SECRET_KEY=<your-airflow-webserver-secret-key>
